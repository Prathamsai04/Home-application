# ---------------------------------------------------------------------------
# Homestay Management System - environment variables
# Every variable is optional. Safe demo defaults are applied when omitted.
# Configure these in Vercel: Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Secret used to sign demo session tokens (HMAC-SHA256). Minimum 32 characters.
# Set a unique random value in every deployed environment.
AUTH_TOKEN_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# Session token lifetime in seconds (300 - 604800). Default: 43200 (12 hours)
AUTH_TOKEN_TTL_SECONDS=43200

# Comma separated list of allowed origins, or * to allow any origin.
CORS_ORIGIN=*

# Per-instance rate limiting (fixed window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# IANA time zone used to resolve "today" for arrivals, departures and dashboards.
DEMO_TIMEZONE=Asia/Kolkata

# Frontend: API base URL. Keep the default for Vercel (same-origin rewrite).
VITE_API_BASE_URL=/api/v1
